# Το κλειδί της ψευδωνυμοποίησης. ΠΟΤΕ σε repository ή κοινόχρηστο φάκελο:
# όποιος το έχει, αντιστρέφει κάθε hash εσωτερικής IP σε δευτερόλεπτα
# (254 διευθύνσεις, ένα HMAC η καθεμία).
.env

# Δεδομένα: 8,2 GB, και τα raw περιέχουν μη ανωνυμοποιημένες IP.
data/

# Παραγόμενα. Το results/ μένει εκτός ως όγκος· αν χρειαστεί να μοιραστούν
# συγκεκριμένα αποτελέσματα, προστίθενται ρητά με git add -f.
results/
*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

